# latexmkrc — Project build configuration
# Works locally (latexmk) and on Overleaf (reads this file automatically).
# Overleaf ignores $pdf_mode — set the compiler to pdfLaTeX via the project menu.

# Use pdfLaTeX (mode 1). The apa7 class and biblatex-apa are developed and
# tested on pdfLaTeX. Switch to $pdf_mode = 5 (XeLaTeX) only if you need system fonts.
$pdf_mode = 1;
$postscript_mode = $dvi_mode = 0;

# Bibliography: biblatex-apa requires biber (latexmk runs it automatically)
$bibtex_use = 2;

# Search paths for preambles and bibliography
ensure_path('TEXINPUTS', './preambles//');
ensure_path('BIBINPUTS', '..//');

# Silence — stop on errors but don't pause
$pdflatex = 'pdflatex -interaction=nonstopmode %O %S';
